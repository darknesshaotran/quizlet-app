<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        // Áp dụng theme (sáng/tối) đã lưu NGAY LẬP TỨC, trước khi trang vẽ ra,
        // để tránh bị nháy sáng 1 khoảnh khắc rồi mới chuyển tối.
        try {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) {}
    </script>
    <title>JLPT Quizlet App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav class="navbar">
        <div class="nav-item">
            <a href="https://drive.google.com/drive/u/1/folders/1DrSGyGi_NTzeRsGrJYV-iM9wQVmP8iKC" target="_blank">textBook</a>
        </div>
        
        <!-- Dropdown Bài Học Chính (kèm Progress Bar % đã thuộc) -->
        <div class="nav-item nav-jlpt">
            <span class="nav-btn">JLPT ▾</span>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li class="progress-item">
                                <div class="progress-item-row">
                                    <a href="/quizlet/tu-vung/<%= level %>">Từ vựng</a>
                                    <a class="quiz-quicklink" href="/quiz/tu-vung/<%= level %>" title="Chế độ Quiz trắc nghiệm">🎯</a>
                                </div>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="progress-tu-vung-<%= level %>"></div>
                                </div>
                                <span class="progress-label" id="progress-label-tu-vung-<%= level %>">0%</span>
                            </li>
                            <li class="progress-item">
                                <div class="progress-item-row">
                                    <a href="/quizlet/ngu-phap/<%= level %>">Ngữ pháp</a>
                                    <a class="quiz-quicklink" href="/quiz/ngu-phap/<%= level %>" title="Chế độ Quiz trắc nghiệm">🎯</a>
                                </div>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="progress-ngu-phap-<%= level %>"></div>
                                </div>
                                <span class="progress-label" id="progress-label-ngu-phap-<%= level %>">0%</span>
                            </li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <!-- Dropdown Từ Chưa Thuộc -->
        <div class="nav-item">
            <span class="nav-btn" style="color: #d98a92; font-weight: 700;">⚠ Chưa thuộc ▾</span>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li><a href="/quizlet/tu-vung/<%= level %>?mode=unlearned">Từ vựng</a></li>
                            <li><a href="/quizlet/ngu-phap/<%= level %>?mode=unlearned">Ngữ pháp</a></li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <!-- Dropdown Từ Đã Thuộc -->
        <div class="nav-item">
            <span class="nav-btn" style="color: #5fb891; font-weight: 700;">✓ Đã thuộc ▾</span>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li><a href="/quizlet/tu-vung/<%= level %>?mode=learned">Từ vựng</a></li>
                            <li><a href="/quizlet/ngu-phap/<%= level %>?mode=learned">Ngữ pháp</a></li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <div class="nav-item">
            <a href="https://drive.google.com/drive/folders/1n3P0RVh_--djt3Pd_f9Huxng1_1eIC5s" target="_blank">Luyện thi</a>
        </div>

        <div class="nav-item">
            <a href="/import">Import</a>
        </div>

        <div class="nav-item">
            <a href="/dashboard">📊 Dashboard</a>
        </div>

        <button class="theme-toggle-btn" id="btn-theme-toggle" type="button" title="Chuyển giao diện sáng/tối" aria-label="Chuyển giao diện sáng/tối">🌙</button>
    </nav>

    <div class="container">
        <!-- <h1>HỌC ĐÊ LÊ HỒNG!</h1> -->
        <p>Hãy chọn mục học trên Thanh Menu để bắt đầu.</p>
    </div>

    <script>
    (function () {
        var TYPES = ['tu-vung', 'ngu-phap'];
        var LEVELS = ['n1', 'n2', 'n3', 'n4', 'n5'];
        var cachedCounts = null; // Tổng số thẻ/level không đổi trong phiên, nên chỉ cần fetch 1 lần

        function getLearnedCount(type, level) {
            try {
                var list = JSON.parse(localStorage.getItem('learned_' + type + '_' + level) || '[]');
                return Array.isArray(list) ? list.length : 0;
            } catch (e) {
                return 0;
            }
        }

        function paint(type, level, percent) {
            var fill = document.getElementById('progress-' + type + '-' + level);
            var label = document.getElementById('progress-label-' + type + '-' + level);
            if (fill) fill.style.width = percent + '%';
            if (label) label.innerText = percent + '%';
        }

        // Đọc lại localStorage (có thể vừa thay đổi) và tô lại tất cả progress bar
        function repaintAll(counts) {
            TYPES.forEach(function (type) {
                LEVELS.forEach(function (level) {
                    var total = (counts[type] && counts[type][level]) || 0;
                    var learned = getLearnedCount(type, level);
                    var percent = total > 0 ? Math.round((learned / total) * 100) : 0;
                    paint(type, level, percent);
                });
            });
        }

        // Gọi hàm này bất cứ khi nào muốn cập nhật % (hover, load trang, sau khi học xong...)
        function refreshProgress() {
            if (cachedCounts) {
                repaintAll(cachedCounts);
                return;
            }
            fetch('/api/counts')
                .then(function (res) { return res.json(); })
                .then(function (counts) {
                    cachedCounts = counts;
                    repaintAll(counts);
                })
                .catch(function () { /* Không lấy được dữ liệu, giữ nguyên 0% */ });
        }

        // Cập nhật ngay khi trang tải xong
        refreshProgress();

        // Cập nhật lại NGAY khi hover/chạm vào menu JLPT (N1-N5), để luôn phản ánh đúng % mới nhất
        var jlptNav = document.querySelector('.nav-jlpt');
        if (jlptNav) {
            jlptNav.addEventListener('mouseenter', refreshProgress);
            jlptNav.addEventListener('focusin', refreshProgress);
            jlptNav.addEventListener('touchstart', refreshProgress, { passive: true });
        }

        // Nếu người dùng có nhiều tab, khi quay lại tab này thì cập nhật luôn
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') refreshProgress();
        });
    })();
    </script>

    <script>
    (function () {
        // ==== Chuyển giao diện Sáng / Tối ====
        // Trạng thái lưu chung ở localStorage key 'theme' ('dark' hoặc không có = sáng),
        // áp dụng cho MỌI trang vì đoạn script chống-nháy ở đầu <head> mỗi trang
        // cũng đọc cùng key này (xem đầu file <head>).
        var THEME_KEY = 'theme';

        function getTheme() {
            try { return localStorage.getItem(THEME_KEY) || 'light'; } catch (e) { return 'light'; }
        }
        function applyTheme(theme) {
            if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            else document.documentElement.removeAttribute('data-theme');
        }
        function updateToggleUI() {
            var btn = document.getElementById('btn-theme-toggle');
            if (!btn) return;
            var dark = getTheme() === 'dark';
            btn.textContent = dark ? '☀️' : '🌙';
            var label = dark ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối';
            btn.title = label;
            btn.setAttribute('aria-label', label);
        }

        var toggleBtn = document.getElementById('btn-theme-toggle');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                var next = getTheme() === 'dark' ? 'light' : 'dark';
                try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
                applyTheme(next);
                updateToggleUI();
            });
        }

        // Trang đã được áp data-theme ngay từ đầu <head> (chống nháy) nếu là tối;
        // ở đây chỉ cần đồng bộ lại icon nút cho khớp trạng thái hiện có.
        updateToggleUI();
    })();
    </script>
</body>
</html>