<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JLPT Quizlet - Ôn Thi Từ Vựng & Ngữ Pháp Tiếng Nhật N1-N5</title>
    <meta name="description" content="Ứng dụng học và ôn thi JLPT N1, N2, N3, N4, N5 qua Flashcard Quizlet. Học từ vựng, ngữ pháp tiếng Nhật hiệu quả với bài tập trắc nghiệm miễn phí.">
    <meta name="keywords" content="jlpt quizlet, học từ vựng jlpt, ôn thi jlpt n2, ngữ pháp jlpt, flashcard tiếng nhật, mimikara oboeru, jlpt n1, jlpt n2, jlpt n3, jlpt n4, jlpt n5, học tiếng nhật online, học tiếng nhật miễn phí, từ vựng tiếng nhật, ngữ pháp tiếng nhật, học kanji, miễn phí, học tiếng nhật, luyện thi jlpt, jlpt practice, jlpt test, jlpt vocabulary, jlpt grammar">
    <meta name="robots" content="index, follow">
    <script>
        // Áp dụng theme (sáng/tối) đã lưu NGAY LẬP TỨC, trước khi trang vẽ ra,
        // để tránh bị nháy sáng 1 khoảnh khắc rồi mới chuyển tối.
        try {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) {}
    </script>
    <title>JLPT Quizlet App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <% var isLoggedIn = (typeof user !== 'undefined' && user) ? true : false; %>
    <nav class="navbar">
        <div class="nav-item">
            <a href="https://drive.google.com/drive/u/1/folders/1DrSGyGi_NTzeRsGrJYV-iM9wQVmP8iKC" target="_blank">textBook</a>
        </div>
        
        <!-- Dropdown Bài Học Chính (kèm Progress Bar % đã thuộc) -->
        <div class="nav-item nav-jlpt">
            <button type="button" class="nav-btn" aria-haspopup="true" aria-expanded="false">JLPT ▾</button>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#" aria-haspopup="true" aria-expanded="false"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li class="progress-item">
                                <div class="progress-item-row">
                                    <a href="/quizlet/tu-vung/<%= level %>">Từ vựng</a>
                                    <a class="quiz-quicklink" href="/quiz/tu-vung/<%= level %>" title="Chế độ Quiz trắc nghiệm">🎯</a>
                                </div>
                                <% if (isLoggedIn) { %>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="progress-tu-vung-<%= level %>"></div>
                                </div>
                                <span class="progress-label" id="progress-label-tu-vung-<%= level %>">0%</span>
                                <% } %>
                            </li>
                            <li class="progress-item">
                                <div class="progress-item-row">
                                    <a href="/quizlet/ngu-phap/<%= level %>">Ngữ pháp</a>
                                    <a class="quiz-quicklink" href="/quiz/ngu-phap/<%= level %>" title="Chế độ Quiz trắc nghiệm">🎯</a>
                                </div>
                                <% if (isLoggedIn) { %>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="progress-ngu-phap-<%= level %>"></div>
                                </div>
                                <span class="progress-label" id="progress-label-ngu-phap-<%= level %>">0%</span>
                                <% } %>
                            </li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <!-- Dropdown Từ Chưa Thuộc -->
        <div class="nav-item">
            <button type="button" class="nav-btn" aria-haspopup="true" aria-expanded="false" style="color: #d98a92; font-weight: 700;">⚠ Chưa thuộc ▾</button>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#" aria-haspopup="true" aria-expanded="false"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li><a href="/quizlet/tu-vung/<%= level %>?mode=unlearned">Từ vựng</a></li>
                            <li><a href="/quizlet/ngu-phap/<%= level %>?mode=unlearned">Ngữ pháp</a></li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <!-- Dropdown Từ Đã Thuộc -->
        <div class="nav-item">
            <button type="button" class="nav-btn" aria-haspopup="true" aria-expanded="false" style="color: #5fb891; font-weight: 700;">✓ Đã thuộc ▾</button>
            <ul class="dropdown-menu">
                <% ['n1','n2','n3','n4','n5'].forEach(level => { %>
                    <li class="dropdown-item">
                        <a href="#" aria-haspopup="true" aria-expanded="false"><%= level.toUpperCase() %> ▸</a>
                        <ul class="sub-dropdown">
                            <li><a href="/quizlet/tu-vung/<%= level %>?mode=learned">Từ vựng</a></li>
                            <li><a href="/quizlet/ngu-phap/<%= level %>?mode=learned">Ngữ pháp</a></li>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        </div>

        <div class="nav-item">
            <a href="https://drive.google.com/drive/folders/1n3P0RVh_--djt3Pd_f9Huxng1_1eIC5s" target="_blank">Luyện thi</a>
        </div>

        <div class="nav-item">
            <a href="/dashboard">📊 Dashboard</a>
        </div>

        <div class="nav-item">
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="nav-user">
                    <span class="nav-user-email" title="<%= user.email %>">👤 <%= user.email %></span>
                    <form action="/logout" method="POST" class="nav-logout-form">
                        <button type="submit" class="nav-logout-btn">Đăng xuất</button>
                    </form>
                </div>
            <% } else { %>
                <a href="/login">Đăng nhập</a>
            <% } %>
        </div>

        <div class="nav-controls">
            <button class="header-toggle-btn" id="btn-hide-header" type="button" title="Ẩn thanh menu" aria-label="Ẩn thanh menu"><span class="icon-desktop">▲</span><span class="icon-phone">✕</span></button>
            <button class="theme-toggle-btn" id="btn-theme-toggle" type="button" title="Chuyển giao diện sáng/tối" aria-label="Chuyển giao diện sáng/tối">🌙</button>
        </div>
    </nav>

    <!-- Nút nổi để hiện lại thanh menu khi đang ẩn -->
    <button class="header-restore-btn" id="btn-show-header" type="button" title="Hiện lại thanh menu" aria-label="Hiện lại thanh menu" style="display:none;">☰</button>

    <div class="container">
        <!-- <h1>HỌC ĐÊ LÊ HỒNG!</h1> -->
        <p>Hãy chọn mục học trên Thanh Menu để bắt đầu.</p>
    </div>

    <script>
    (function () {
        // Chỉ người đã đăng nhập mới có tiến độ trên DB -> khách không hiện thanh % và không gọi API
        var LOGGED_IN = <%= isLoggedIn %>;
        var TYPES = ['tu-vung', 'ngu-phap'];
        var LEVELS = ['n1', 'n2', 'n3', 'n4', 'n5'];
        var cachedCounts = null; // Tổng số thẻ/level không đổi trong phiên, nên chỉ cần fetch 1 lần
        var learnedSummary = {}; // Số thẻ ĐÃ THUỘC theo type/level, lấy từ DB: { 'tu-vung': { n1: 12, ... }, ... }
        var inFlight = false;
        var lastFetch = 0;

        function getLearnedCount(type, level) {
            return (learnedSummary[type] && learnedSummary[type][level]) || 0;
        }

        function loadTotals() {
            if (cachedCounts) return Promise.resolve(cachedCounts);
            return fetch('/api/counts')
                .then(function (res) { return res.json(); })
                .then(function (counts) { cachedCounts = counts; return counts; });
        }

        function loadLearned() {
            return fetch('/api/progress-summary', { credentials: 'same-origin' })
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status); // chưa đăng nhập -> giữ 0%
                    return res.json();
                });
        }

        function paint(type, level, percent) {
            var fill = document.getElementById('progress-' + type + '-' + level);
            var label = document.getElementById('progress-label-' + type + '-' + level);
            if (fill) fill.style.width = percent + '%';
            if (label) label.innerText = percent + '%';
        }

        // Tô lại tất cả progress bar theo số liệu mới nhất
        function repaintAll(counts) {
            TYPES.forEach(function (type) {
                LEVELS.forEach(function (level) {
                    var total = (counts[type] && counts[type][level]) || 0;
                    var learned = getLearnedCount(type, level);
                    var percent = total > 0 ? Math.round((learned / total) * 100) : 0;
                    paint(type, level, percent);
                });
            });
        }

        // Gọi hàm này bất cứ khi nào muốn cập nhật % (bấm menu, load trang, sau khi học xong...)
        // Số liệu "đã thuộc" nằm trên DB nên mỗi lần refresh là 1 request -> chặn gọi dồn dập
        // (bấm liên tục) bằng cờ inFlight + khoảng nghỉ tối thiểu 2 giây.
        function refreshProgress() {
            if (!LOGGED_IN) return;
            var now = Date.now();
            if (inFlight || now - lastFetch < 2000) return;
            inFlight = true;
            Promise.all([loadTotals(), loadLearned()])
                .then(function (r) {
                    learnedSummary = r[1] || {};
                    lastFetch = Date.now();
                    repaintAll(r[0]);
                })
                .catch(function (e) { console.warn('Không tải được tiến độ:', e); /* giữ nguyên số cũ */ })
                .then(function () { inFlight = false; });
        }

        // Cập nhật ngay khi trang tải xong
        refreshProgress();

        // Cập nhật lại khi BẤM vào menu JLPT (N1-N5), để luôn phản ánh đúng % mới nhất
        var jlptNav = document.querySelector('.nav-jlpt');
        if (jlptNav) jlptNav.addEventListener('click', refreshProgress);

        // Nếu người dùng có nhiều tab, khi quay lại tab này thì cập nhật luôn
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') refreshProgress();
        });
    })();
    </script>

    <script>
    (function () {
        // ==== Chuyển giao diện Sáng / Tối ====
        // Trạng thái lưu chung ở localStorage key 'theme' ('dark' hoặc không có = sáng),
        // áp dụng cho MỌI trang vì đoạn script chống-nháy ở đầu <head> mỗi trang
        // cũng đọc cùng key này (xem đầu file <head>).
        var THEME_KEY = 'theme';

        function getTheme() {
            try { return localStorage.getItem(THEME_KEY) || 'light'; } catch (e) { return 'light'; }
        }
        function applyTheme(theme) {
            if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            else document.documentElement.removeAttribute('data-theme');
        }
        function updateToggleUI() {
            var btn = document.getElementById('btn-theme-toggle');
            if (!btn) return;
            var dark = getTheme() === 'dark';
            btn.textContent = dark ? '☀️' : '🌙';
            var label = dark ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối';
            btn.title = label;
            btn.setAttribute('aria-label', label);
        }

        var toggleBtn = document.getElementById('btn-theme-toggle');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                var next = getTheme() === 'dark' ? 'light' : 'dark';
                try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
                applyTheme(next);
                updateToggleUI();
            });
        }

        // Trang đã được áp data-theme ngay từ đầu <head> (chống nháy) nếu là tối;
        // ở đây chỉ cần đồng bộ lại icon nút cho khớp trạng thái hiện có.
        updateToggleUI();
    })();
    </script>

    <script>
    (function () {
        // ==== Điều khiển navbar ====
        // 1) Dropdown mở/đóng bằng CLICK (không dùng hover) -> dùng được trên điện thoại/tablet.
        // 2) Máy tính/tablet: nút ▲ ẩn thanh menu, nút ☰ nổi hiện lại (nhớ lựa chọn trong localStorage).
        // 3) Điện thoại (<= 600px): header là menu TOÀN MÀN HÌNH, mở bằng ☰, đóng bằng ✕ hoặc nút Back.
        var HEADER_KEY = 'headerHidden';
        var navbar = document.querySelector('.navbar');
        var hideBtn = document.getElementById('btn-hide-header');
        var restoreBtn = document.getElementById('btn-show-header');
        if (!navbar || !hideBtn || !restoreBtn) return;

        var phoneQuery = window.matchMedia('(max-width: 600px)');
        function isPhone() { return phoneQuery.matches; }

        // ---------- Dropdown: bấm để mở/đóng ----------
        function setExpanded(item, open) {
            item.classList.toggle('is-open', open);
            var trigger = item.firstElementChild;
            if (trigger && trigger.hasAttribute('aria-expanded')) {
                trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
        }
        function closeItem(item) {
            setExpanded(item, false);
            Array.prototype.forEach.call(item.querySelectorAll('.is-open'), function (el) { setExpanded(el, false); });
        }
        function closeAllDropdowns() {
            Array.prototype.forEach.call(navbar.querySelectorAll('.is-open'), function (el) { setExpanded(el, false); });
        }

        navbar.addEventListener('click', function (e) {
            var trigger = e.target.closest('.nav-item > .nav-btn, .dropdown-item > a[href="#"]');
            if (!trigger || !navbar.contains(trigger)) return;
            e.preventDefault();
            var item = trigger.parentElement;
            var willOpen = !item.classList.contains('is-open');
            // Chỉ mở 1 mục mỗi cấp: đóng các mục cùng cấp trước
            Array.prototype.forEach.call(item.parentElement.children, function (el) {
                if (el !== item) closeItem(el);
            });
            if (willOpen) setExpanded(item, true); else closeItem(item);
        });

        // Bấm ra ngoài thanh menu thì đóng dropdown (máy tính/tablet)
        document.addEventListener('click', function (e) {
            if (!navbar.contains(e.target) && !restoreBtn.contains(e.target)) closeAllDropdowns();
        });

        // ---------- Menu toàn màn hình trên điện thoại ----------
        var menuPushed = false; // đã đẩy 1 mục vào lịch sử để nút Back đóng được menu
        var afterBack = null;

        function menuOpen() { return navbar.classList.contains('is-open'); }

        function openMenu() {
            if (menuOpen()) return;
            navbar.classList.add('is-open');
            document.body.classList.add('menu-open');
            try { history.pushState({ navMenu: true }, ''); menuPushed = true; } catch (e) { menuPushed = false; }
        }
        function hideMenuUI() {
            navbar.classList.remove('is-open');
            document.body.classList.remove('menu-open');
            closeAllDropdowns();
        }
        // Đóng bằng ✕: lùi 1 bước lịch sử để không để lại mục thừa (Back sau đó không bị "kẹt")
        function closeMenu() {
            hideMenuUI();
            if (menuPushed) { menuPushed = false; history.back(); }
        }
        function runAfterBack() {
            var fn = afterBack;
            afterBack = null;
            if (fn) fn();
        }
        // Chuyển trang từ trong menu: lùi lịch sử trước rồi mới đi, để lịch sử sạch (không dính mục "menu mở")
        function goAfterBack(fn) {
            if (!menuPushed) { fn(); return; }
            afterBack = fn;
            hideMenuUI();
            menuPushed = false;
            history.back();
            setTimeout(runAfterBack, 400); // phòng khi popstate không bắn
        }

        // Người dùng bấm Back (nút điện thoại / trình duyệt) -> đóng menu, ở lại trang
        window.addEventListener('popstate', function () {
            if (menuOpen()) { menuPushed = false; hideMenuUI(); }
            runAfterBack();
        });

        navbar.addEventListener('click', function (e) {
            if (!isPhone() || !menuOpen()) return;
            var a = e.target.closest('a[href]');
            if (!a || a.getAttribute('href') === '#') return;
            if (a.target === '_blank') { closeMenu(); return; } // mở tab mới, chỉ đóng menu
            e.preventDefault();
            var href = a.href;
            goAfterBack(function () { window.location.href = href; });
        });
        navbar.addEventListener('submit', function (e) { // VD: nút Đăng xuất
            if (!isPhone() || !menuPushed) return;
            e.preventDefault();
            var form = e.target;
            goAfterBack(function () { form.submit(); });
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if (isPhone() && menuOpen()) closeMenu(); else closeAllDropdowns();
        });

        // ---------- Ẩn/hiện thanh menu trên máy tính/tablet ----------
        function isHidden() {
            try { return localStorage.getItem(HEADER_KEY) === '1'; } catch (e) { return false; }
        }
        function applyHidden(hidden) {
            navbar.classList.toggle('is-hidden', hidden);
            restoreBtn.style.display = hidden ? 'flex' : 'none';
        }
        function setHidden(hidden) {
            try { localStorage.setItem(HEADER_KEY, hidden ? '1' : '0'); } catch (e) {}
            applyHidden(hidden);
        }

        hideBtn.addEventListener('click', function () {
            if (isPhone()) closeMenu(); else setHidden(true);
        });
        restoreBtn.addEventListener('click', function () {
            if (isPhone()) openMenu(); else setHidden(false);
        });

        // Đổi chế độ (xoay màn hình, kéo giãn cửa sổ): dọn trạng thái cho đúng chế độ mới
        function applyMode() {
            if (isPhone()) {
                navbar.classList.remove('is-hidden'); // trên điện thoại menu do nút ☰ điều khiển
            } else {
                if (menuOpen()) closeMenu();
                applyHidden(isHidden());
            }
        }
        if (phoneQuery.addEventListener) phoneQuery.addEventListener('change', applyMode);
        else if (phoneQuery.addListener) phoneQuery.addListener(applyMode);

        applyMode();
    })();
    </script>
</body>
</html>