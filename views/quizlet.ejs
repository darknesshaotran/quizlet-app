<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        // Áp dụng theme (sáng/tối) đã lưu NGAY LẬP TỨC, trước khi trang vẽ ra,
        // để tránh bị nháy sáng 1 khoảnh khắc rồi mới chuyển tối.
        try {
            if (localStorage.getItem('theme') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) {}
    </script>
    <title>Học <%= type %> - <%= level.toUpperCase() %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1/dist/confetti.browser.min.js"></script>
</head>
<body>
    <%- include('index.ejs') %>

    <div class="container" id="app">
        <h2>
            <%= isUnlearned ? '⚠️ Đang ôn (chưa thuộc):' : (isLearned ? '✅ Xem lại (đã thuộc):' : 'Đang học:') %>
            <%= type.toUpperCase() %> - <%= level.toUpperCase() %>
        </h2>

        <% if (!(typeof user !== 'undefined' && user)) { %>
        <div class="guest-note">
            Bạn đang học ở chế độ khách: tiến độ chỉ lưu trên thiết bị này.
            <a href="/login">Đăng nhập</a> để lưu lên tài khoản và đồng bộ giữa các thiết bị.
        </div>
        <% } %>

        <div id="stats" style="font-weight: 700; color: var(--ink-soft); margin-bottom: 6px; letter-spacing: 0.3px;"></div>

        <!-- Thanh công cụ: Trộn thẻ / Hoàn tác / SRS / Phiên âm / Học lại từ đầu -->
        <div class="toolbar" id="toolbar">
            <button class="btn-tool" id="btn-shuffle" title="Trộn ngẫu nhiên các thẻ chưa xem">🔀 Trộn thẻ</button>
            <button class="btn-tool" id="btn-undo" title="Hoàn tác thao tác vừa rồi" disabled>↩️ Hoàn tác</button>
            <button class="btn-tool" id="btn-srs-toggle" title="Bật/tắt chế độ Spaced Repetition (SM-2)">🧠 SRS: TẮT</button>
            <button class="btn-tool" id="btn-toggle-furigana" title="Ẩn/hiện phiên âm ở mặt trước thẻ">あ Phiên âm: HIỆN</button>
            <button class="btn-tool btn-tool-ghost" id="btn-reset-session" title="Xoá tiến trình phiên này và học lại từ đầu">↺ Học lại từ đầu</button>
            <button class="btn-tool btn-tool-danger" id="btn-clear-all" title="Xoá vĩnh viễn toàn bộ Đã thuộc / Chưa thuộc / lịch SRS của mục này">🗑️ Xoá tiến độ</button>
        </div>

        <!-- Khung 3D Flashcard + Nút điều hướng Trước / Sau -->
        <div class="card-nav-wrapper" id="card-nav-wrapper">
            <button class="nav-arrow nav-arrow-left" id="btn-prev" onclick="prevCard()" title="Thẻ trước (←)" aria-label="Thẻ trước">&#8249;</button>

            <div class="card-scene" id="card-scene" onclick="handleCardClick()">
                <div class="card-inner" id="card-inner">
                    <div class="card-front" id="card-front"></div>
                    <div class="card-back" id="card-back"></div>
                </div>
                <div class="swipe-hint swipe-hint-left" id="swipe-hint-left">CHƯA THUỘC</div>
                <div class="swipe-hint swipe-hint-right" id="swipe-hint-right">ĐÃ THUỘC</div>
            </div>

            <button class="nav-arrow nav-arrow-right" id="btn-next" onclick="nextCard()" title="Thẻ tiếp theo (→)" aria-label="Thẻ tiếp theo">&#8250;</button>
        </div>

        <div class="hint-row">Space/Enter: lật thẻ · ←/→: chuyển thẻ · 1/2: đánh dấu · vuốt trái/phải trên di động · đánh dấu lại một thẻ sẽ luôn thay thế lượt trước đó</div>

        <div class="btn-group" id="action-btns">
            <button class="btn btn-danger" id="btn-mark-unknown" onclick="markCard(false)">Chưa thuộc <span class="kbd-hint">1</span></button>
            <button class="btn btn-success" id="btn-mark-known" onclick="markCard(true)">Đã thuộc <span class="kbd-hint">2</span></button>
        </div>

        <div class="btn-group srs-btn-group" id="srs-btns" style="display:none;">
            <button class="btn btn-srs btn-srs-again" onclick="gradeCard(0)">Lại <span class="kbd-hint">1</span></button>
            <button class="btn btn-srs btn-srs-hard" onclick="gradeCard(1)">Khó <span class="kbd-hint">2</span></button>
            <button class="btn btn-srs btn-srs-good" onclick="gradeCard(2)">Tốt <span class="kbd-hint">3</span></button>
            <button class="btn btn-srs btn-srs-easy" onclick="gradeCard(3)">Dễ <span class="kbd-hint">4</span></button>
        </div>

        <div id="counter-stats" style="margin-top: 18px; display: flex; justify-content: center; gap: 12px; font-weight: 700;">
            <span style="color: var(--emerald);">Đã thuộc: <span id="count-known">0</span></span>
            <span style="color: var(--ruby);">Chưa thuộc: <span id="count-unknown">0</span></span>
        </div>

        <!-- Màn hình không còn thẻ nào cần ôn hôm nay (chế độ SRS) -->
        <div id="srs-empty-screen" style="display: none;">
            <h3>🎉 Không còn thẻ nào cần ôn hôm nay!</h3>
            <p style="color: var(--ink-soft);">Các thẻ sẽ tự động quay lại đúng lịch (SM-2) khi đến hạn ôn tập.</p>
            <div class="btn-group">
                <button class="btn btn-primary" onclick="toggleSrs(false)">Tắt SRS, học toàn bộ ngay</button>
            </div>
        </div>

        <!-- Màn hình hoàn thành -->
        <div id="complete-screen" style="display: none;">
            <h3>🎉 Bạn đã hoàn thành lượt học!</h3>
            <div class="btn-group">
                <button class="btn btn-primary" onclick="restart(false)">Học lại toàn bộ</button>
                <button class="btn btn-danger" onclick="restart(true)">Chỉ học lại các từ CHƯA THUỘC</button>
            </div>
        </div>
    </div>

    <script>
const typeKey = '<%= type %>';
const levelKey = '<%= level %>';
const isUnlearnedMode = <%= isUnlearned %>;
const isLearnedMode = <%= isLearned %>;
// Khách (chưa đăng nhập) vẫn học bình thường, tiến độ lưu localStorage trên thiết bị.
// Đã đăng nhập: lưu lên DB, đồng bộ giữa các thiết bị.
const isLoggedIn = <%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
const modeKey = isLearnedMode ? 'learned' : (isUnlearnedMode ? 'unlearned' : 'normal');

// Giá trị cột `status` trong bảng user_progress (đổi ở đây nếu DB của bạn dùng giá trị khác)
const STATUS_LEARNED = 'learned';
const STATUS_UNLEARNED = 'unlearned';

// SRS + cờ confetti vẫn lưu localStorage (server chưa có bảng/API cho phần này)
const srsStorageKey = `srs_${typeKey}_${levelKey}`;
const srsEnabledKey = `srsEnabled_${typeKey}_${levelKey}`;
const confettiFlagKey = `confetti_done_${typeKey}_${levelKey}`;

// Key CŨ trong localStorage — chỉ dùng để chuyển dữ liệu cũ lên DB một lần
const legacyUnlearnedKey = `unlearned_${typeKey}_${levelKey}`;
const legacyLearnedKey = `learned_${typeKey}_${levelKey}`;
// Tiến độ + vị trí học của KHÁCH (chưa đăng nhập)
const guestProgressKey = `guestProgress_${typeKey}_${levelKey}`;
const guestSessionKey = `guestSession_${typeKey}_${levelKey}_${modeKey}`;

// Lấy dữ liệu gốc từ Server
const originalCards = <%- JSON.stringify(cards) %>;

// ==== Gọi API ====
async function api(method, url, body, extra) {
    const res = await fetch(url, Object.assign({
        method,
        credentials: 'same-origin',
        headers: body ? { 'Content-Type': 'application/json' } : {},
        body: body ? JSON.stringify(body) : undefined
    }, extra || {}));
    // Hết phiên đăng nhập: requireAuth trả 401 hoặc redirect về /login
    if (res.status === 401 || (res.redirected && /\/login/.test(res.url))) {
        window.location.href = '/login';
        throw new Error('Chưa đăng nhập');
    }
    if (!res.ok) {
        // Lấy lý do thật từ server (route trả { error: '...' }) để biết vì sao lưu lỗi
        let detail = '';
        try { const j = await res.json(); detail = (j && j.error) ? j.error : ''; } catch (e) {}
        throw new Error(`${method} ${url} -> ${res.status}${detail ? ' | ' + detail : ''}`);
    }
    return res.json();
}

let toastTimer = null;
function showSyncError(msg) {
    let el = document.getElementById('sync-toast');
    if (!el) {
        el = document.createElement('div');
        el.id = 'sync-toast';
        el.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);' +
            'background:var(--ruby,#b3261e);color:#fff;padding:10px 18px;border-radius:10px;' +
            'font-weight:700;z-index:9999;box-shadow:0 6px 20px rgba(0,0,0,.25);max-width:90vw;text-align:center;';
        document.body.appendChild(el);
    }
    el.textContent = msg || 'Không lưu được lên máy chủ. Kiểm tra kết nối rồi thử lại.';
    el.style.display = 'block';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { el.style.display = 'none'; }, 8000);
}

// Hàng đợi ghi tuần tự: các thao tác chạy đúng thứ tự bấm, tránh request đến sai thứ tự
// làm DB lưu trạng thái cũ (VD: bấm Đã thuộc rồi Hoàn tác thật nhanh).
let writeChain = Promise.resolve();
function enqueue(task) {
    writeChain = writeChain.then(task).catch(err => {
        console.error('Lỗi đồng bộ:', err);
        showSyncError('Không lưu được lên máy chủ: ' + (err && err.message ? err.message : err));
    });
}

// ==== Tiến độ Đã thuộc / Chưa thuộc: lưu trên DB, cache trong bộ nhớ ====
// progressMap: card_id -> STATUS_LEARNED | STATUS_UNLEARNED (mỗi thẻ chỉ có 1 trạng thái -> loại trừ nhau)
const progressMap = {};

function getSavedLearned() { return originalCards.filter(c => progressMap[String(c.id)] === STATUS_LEARNED); }
function getSavedUnlearned() { return originalCards.filter(c => progressMap[String(c.id)] === STATUS_UNLEARNED); }
function isInLearned(cardId) { return progressMap[String(cardId)] === STATUS_LEARNED; }
function isInUnlearned(cardId) { return progressMap[String(cardId)] === STATUS_UNLEARNED; }
function learnedCount() {
    let n = 0;
    for (const k in progressMap) if (progressMap[k] === STATUS_LEARNED) n++;
    return n;
}

function setStatus(cardId, status) {
    const id = String(cardId);
    if (progressMap[id] === status) return;
    progressMap[id] = status;
    if (!isLoggedIn) { saveGuestProgress(); return; }
    enqueue(() => api('POST', '/api/progress',
        { type: typeKey, level: levelKey, card_id: id, status }, { keepalive: true }));
}
// Chỉ xoá khi thẻ đang đúng trạng thái `onlyIf` (giữ nguyên hành vi của removeFromLearned/Unlearned cũ)
function clearStatus(cardId, onlyIf) {
    const id = String(cardId);
    if (progressMap[id] !== onlyIf) return;
    delete progressMap[id];
    if (!isLoggedIn) { saveGuestProgress(); return; }
    enqueue(() => api('DELETE', `/api/progress/${typeKey}/${levelKey}/${encodeURIComponent(id)}`,
        null, { keepalive: true }));
}

function saveToUnlearned(card) { setStatus(card.id, STATUS_UNLEARNED); }
function removeFromUnlearned(cardId) { clearStatus(cardId, STATUS_UNLEARNED); }
function saveToLearned(card) { setStatus(card.id, STATUS_LEARNED); }
function removeFromLearned(cardId) { clearStatus(cardId, STATUS_LEARNED); }

// ==== Tiến độ của KHÁCH: lưu localStorage dạng { card_id: status } ====
// Đọc cả dữ liệu kiểu cũ (mảng thẻ, từ thời chưa có DB) lẫn kiểu mới.
function readLocalProgress() {
    const map = {};
    try {
        JSON.parse(localStorage.getItem(legacyUnlearnedKey) || '[]')
            .forEach(c => { if (c && c.id != null) map[String(c.id)] = STATUS_UNLEARNED; });
    } catch (e) {}
    try {
        JSON.parse(localStorage.getItem(legacyLearnedKey) || '[]')
            .forEach(c => { if (c && c.id != null) map[String(c.id)] = STATUS_LEARNED; });
    } catch (e) {}
    try { Object.assign(map, JSON.parse(localStorage.getItem(guestProgressKey) || '{}')); } catch (e) {}
    return map;
}

function saveGuestProgress() {
    try {
        localStorage.setItem(guestProgressKey, JSON.stringify(progressMap));
        return true;
    } catch (e) {
        showSyncError('Không lưu được tiến độ trên thiết bị này (bộ nhớ trình duyệt bị chặn hoặc đầy).');
        return false;
    }
}

function clearLocalProgress() {
    [legacyLearnedKey, legacyUnlearnedKey, guestProgressKey].forEach(k => localStorage.removeItem(k));
}

function loadGuestProgress() {
    Object.assign(progressMap, readLocalProgress());
    // Gộp dữ liệu kiểu cũ sang kiểu mới một lần rồi xoá key cũ (nếu không, Hoàn tác sẽ bị "sống lại")
    const hasLegacy = localStorage.getItem(legacyLearnedKey) !== null || localStorage.getItem(legacyUnlearnedKey) !== null;
    if (hasLegacy && saveGuestProgress()) {
        localStorage.removeItem(legacyLearnedKey);
        localStorage.removeItem(legacyUnlearnedKey);
    }
}

// Sau khi đăng nhập: chuyển tiến độ đang lưu trên thiết bị lên tài khoản (chạy 1 lần).
// Chỉ chuyển khi tài khoản CHƯA có tiến độ nào ở mục này, để không ghi đè dữ liệu thật trên DB.
async function migrateLocalToDb() {
    if (Object.keys(progressMap).length > 0) return;
    const local = readLocalProgress();
    const items = Object.keys(local).map(id => ({ card_id: id, status: local[id] }));
    if (!items.length) return;

    await api('POST', '/api/progress/bulk', { type: typeKey, level: levelKey, items });
    items.forEach(i => { progressMap[i.card_id] = i.status; });
    clearLocalProgress();
}

// ==== Ghi nhận ngày học (dùng cho streak ở trang Dashboard) ====
function markStudyToday() {
    try {
        const today = new Date().toISOString().slice(0, 10);
        let dates = JSON.parse(localStorage.getItem('studyDates') || '[]');
        if (!dates.includes(today)) {
            dates.push(today);
            localStorage.setItem('studyDates', JSON.stringify(dates));
        }
    } catch (e) { /* ignore */ }
}
markStudyToday();

// ==== SRS (Spaced Repetition kiểu SM-2 đơn giản hoá) ====
function getSrsData() {
    try { return JSON.parse(localStorage.getItem(srsStorageKey) || '{}'); } catch (e) { return {}; }
}
let srsData = getSrsData();
function saveSrsData() { localStorage.setItem(srsStorageKey, JSON.stringify(srsData)); }

function isSrsEnabled() { return localStorage.getItem(srsEnabledKey) === '1'; }
function setSrsEnabled(val) { localStorage.setItem(srsEnabledKey, val ? '1' : '0'); }

// ==== Bật/tắt hiển thị phiên âm (furigana) ở mặt trước thẻ ====
// Dùng CHUNG 1 key cho mọi type/level vì đây là sở thích hiển thị chung của người học,
// không phải tiến độ riêng từng cấp -> bật/tắt 1 lần, áp dụng mọi nơi.
const FURIGANA_PREF_KEY = 'showFurigana';
function isFuriganaVisible() {
    const v = localStorage.getItem(FURIGANA_PREF_KEY);
    return v === null ? true : v === '1'; // mặc định: HIỆN (giữ đúng hành vi cũ)
}
function setFuriganaVisible(val) {
    localStorage.setItem(FURIGANA_PREF_KEY, val ? '1' : '0');
}
function updateFuriganaToggleUI() {
    const btn = document.getElementById('btn-toggle-furigana');
    if (!btn) return;
    const on = isFuriganaVisible();
    btn.innerText = on ? 'あ Phiên âm: HIỆN' : 'あ Phiên âm: ẨN';
    btn.classList.toggle('btn-tool-active', on);
}

// ==== Phát âm tiếng Nhật: nút 🔊 trên thẻ (speechSynthesis có sẵn trong trình duyệt) ====
const TTS_SUPPORTED = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
let jaVoice = null;
let noVoiceWarned = false;

function pickJaVoice() {
    const list = window.speechSynthesis.getVoices() || [];
    const ja = list.filter(v => /^ja([-_]|$)/i.test(v.lang || ''));
    const best = /Premium|Enhanced|Natural|Google|Kyoko|Otoya|Nanami|Haruka|Ayumi|O-Ren/i;
    jaVoice = ja.find(v => best.test(v.name || '')) || ja[0] || null;
}
if (TTS_SUPPORTED) {
    pickJaVoice(); // Chrome nạp danh sách giọng bất đồng bộ nên phải nghe thêm sự kiện này
    window.speechSynthesis.onvoiceschanged = pickJaVoice;
}

// Chỉ lấy phần chữ Nhật để đọc (bỏ ngoặc, romaji, tiếng Việt, ký hiệu ~).
// Từ vựng ưu tiên cột phiên âm (furigana) vì chữ Hán dễ bị đọc sai.
const JP_RUN = /[\u3040-\u30ff\u31f0-\u31ff\u3400-\u4dbf\u4e00-\u9fff\uff66-\uff9f\u3005]+/g;
function japaneseOnly(raw) {
    const m = String(raw == null ? '' : raw).match(JP_RUN);
    return m ? m.join(' ') : '';
}
function cardSpeechText(card) {
    if (card.kanji || card.furigana) {
        const reading = String(card.furigana || '').split(/[,、;\/／|]/)[0];
        return japaneseOnly(reading) || japaneseOnly(card.kanji);
    }
    return japaneseOnly(card.structure);
}

// Nút 🔊 nằm trên thẻ (cả 2 mặt). stopPropagation để bấm nút không làm lật thẻ.
function speakBtnHtml(card) {
    if (!TTS_SUPPORTED || !cardSpeechText(card)) return '';
    return '<button type="button" class="speak-btn" title="Nghe phát âm" aria-label="Nghe phát âm" ' +
           'onclick="event.stopPropagation(); speakCurrent();">🔊</button>';
}

function speakCurrent() {
    if (!TTS_SUPPORTED) return;
    const card = currentQueue[currentIndex];
    const text = card ? cardSpeechText(card) : '';
    if (!text) return;

    const synth = window.speechSynthesis;
    const hasVoices = (synth.getVoices() || []).length > 0;
    if (hasVoices && !jaVoice && !noVoiceWarned) {
        noVoiceWarned = true;
        showSyncError('Thiết bị chưa có giọng đọc tiếng Nhật. Hãy cài gói ngôn ngữ tiếng Nhật trong cài đặt hệ thống để nghe đúng.');
    }
    if (synth.speaking || synth.pending) synth.cancel(); // ngắt câu đang đọc dở
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'ja-JP';
    if (jaVoice) u.voice = jaVoice;
    u.rate = 0.9; // chậm hơn tốc độ thường một chút cho người học
    synth.speak(u);
}

function todayStr() { return new Date().toISOString().slice(0, 10); }

// Cập nhật lịch ôn tập cho 1 thẻ theo thuật toán SM-2 (grade: 0 Lại, 1 Khó, 2 Tốt, 3 Dễ)
function applySrsGrade(card, grade) {
    let data = srsData[card.id] || { ef: 2.5, interval: 0, reps: 0 };
    if (grade === 0) {
        data.reps = 0;
        data.interval = 1;
        data.ef = Math.max(1.3, data.ef - 0.2);
    } else {
        const q = grade === 1 ? 3 : (grade === 2 ? 4 : 5);
        data.ef = Math.max(1.3, data.ef + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02)));
        data.reps += 1;
        if (data.reps === 1) data.interval = 1;
        else if (data.reps === 2) data.interval = 6;
        else data.interval = Math.round(data.interval * data.ef);
        if (grade === 1) data.interval = Math.max(1, Math.round(data.interval * 0.7));
    }
    const due = new Date();
    due.setDate(due.getDate() + data.interval);
    data.due = due.toISOString().slice(0, 10);
    srsData[card.id] = data;
    saveSrsData();
}

function isDueToday(card) {
    const d = srsData[card.id];
    if (!d || !d.due) return true; // chưa từng ôn -> luôn tính là đến hạn
    return d.due <= todayStr();
}

// Biến khởi tạo: chọn nguồn hàng đợi theo chế độ đang xem
function buildInitialQueue() {
    let base;
    if (isLearnedMode) base = getSavedLearned();
    else if (isUnlearnedMode) base = getSavedUnlearned();
    else base = [...originalCards];

    if (!isLearnedMode && isSrsEnabled()) {
        return base.filter(isDueToday);
    }
    return base;
}

// cardsById: tra cứu thẻ theo id (phục vụ "restart chỉ học lại từ chưa thuộc" và khôi phục session)
let cardsById = {};
function registerCards(list) {
    (list || []).forEach(c => { if (c && c.id != null) cardsById[c.id] = c; });
}
registerCards(originalCards);

let srsFilteredEmpty = false;
let currentQueue = []; // được dựng trong init() sau khi tải xong tiến trình từ DB
let ready = false;     // true khi đã tải xong dữ liệu từ DB -> mới cho phép đánh dấu / lưu

let currentIndex = 0;

// sessionVerdict: id -> 'known' | 'unknown' — PHÁN QUYẾT MỚI NHẤT của mỗi thẻ trong phiên này.
// Đánh dấu lại một thẻ (sau khi bấm ← quay lại) sẽ GHI ĐÈ verdict cũ, không cộng dồn -> tránh đếm trùng.
let sessionVerdict = {};
let actionHistory = [];

// Số Đã thuộc / Chưa thuộc = TỔNG tiến độ của mục này (cùng nguồn với dashboard),
// không còn đếm theo lượt học. sessionVerdict vẫn giữ để phục vụ "Chỉ học lại các từ CHƯA THUỘC".
function computeCounts() {
    let known = 0, unknown = 0;
    Object.keys(progressMap).forEach(id => {
        if (progressMap[id] === STATUS_LEARNED) known++;
        else if (progressMap[id] === STATUS_UNLEARNED) unknown++;
    });
    return { known, unknown };
}

// ==== Lưu / khôi phục vị trí đang học (lưu trên DB, riêng từng mode) ====
let sessionTimer = null;
let sessionDirty = false;

function buildSessionPayload() {
    return {
        type: typeKey,
        level: levelKey,
        mode: modeKey,
        order_ids: currentQueue.map(c => c.id),
        current_index: currentIndex,
        session_verdict: sessionVerdict,
        srs_on: isSrsEnabled()
    };
}

// Gửi ngay (dùng khi rời trang / ẩn tab). keepalive để request không bị huỷ khi trang đóng.
function flushSession(keepalive) {
    clearTimeout(sessionTimer);
    if (!sessionDirty) return;
    sessionDirty = false;
    if (!isLoggedIn) {
        try { localStorage.setItem(guestSessionKey, JSON.stringify(buildSessionPayload())); } catch (e) {}
        return;
    }
    api('POST', '/api/session', buildSessionPayload(), keepalive ? { keepalive: true } : null)
        .catch(e => console.error('Lỗi lưu vị trí học:', e));
}

// Gọi mỗi lần đổi thẻ -> gom lại (debounce) để không bắn 1 request cho mỗi lần bấm.
function saveSession() {
    if (!ready) return; // chưa tải xong từ DB thì tuyệt đối không ghi đè
    sessionDirty = true;
    clearTimeout(sessionTimer);
    sessionTimer = setTimeout(() => flushSession(false), 600);
}

// Server chưa có API xoá session -> ghi đè bằng trạng thái rỗng (restoreSession sẽ bỏ qua).
function clearSession() {
    clearTimeout(sessionTimer);
    sessionDirty = false;
    if (!isLoggedIn) { localStorage.removeItem(guestSessionKey); return; }
    api('POST', '/api/session', {
        type: typeKey, level: levelKey, mode: modeKey,
        order_ids: [], current_index: 0, session_verdict: {}, srs_on: isSrsEnabled()
    }).catch(e => console.error('Lỗi xoá vị trí học:', e));
}

document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') flushSession(true);
});
window.addEventListener('pagehide', () => flushSession(true));

async function loadSession() {
    if (!isLoggedIn) {
        try { return JSON.parse(localStorage.getItem(guestSessionKey) || 'null'); } catch (e) { return null; }
    }
    try { return await api('GET', `/api/session/${typeKey}/${levelKey}/${modeKey}`); }
    catch (e) { console.error('Lỗi tải vị trí học:', e); return null; }
}

function restoreSession(row) {
    if (!row || !Array.isArray(row.order_ids) || row.order_ids.length === 0) return;
    if (!!row.srs_on !== isSrsEnabled()) return; // chế độ SRS thay đổi -> hàng đợi khác, bỏ qua khôi phục

    const savedOrder = row.order_ids.map(String);
    const byId = {};
    currentQueue.forEach(c => { byId[String(c.id)] = c; });
    const freshIds = new Set(currentQueue.map(c => String(c.id)));
    const savedIdsPresent = savedOrder.filter(id => freshIds.has(id));

    // Chỉ khôi phục nếu tập thẻ (theo id) về cơ bản trùng khớp với hàng đợi vừa build
    if (savedIdsPresent.length === 0 || savedIdsPresent.length !== currentQueue.length) return;

    const presentSet = new Set(savedIdsPresent);
    const reordered = savedIdsPresent.map(id => byId[id]);
    currentQueue.forEach(c => { if (!presentSet.has(String(c.id))) reordered.push(c); });

    currentQueue = reordered;
    currentIndex = Math.min(row.current_index || 0, currentQueue.length);

    sessionVerdict = {};
    if (row.session_verdict && typeof row.session_verdict === 'object') {
        Object.keys(row.session_verdict).forEach(id => {
            if (freshIds.has(String(id))) sessionVerdict[id] = row.session_verdict[id];
        });
    }
}

function updateCounters() {
    const { known, unknown } = computeCounts();
    document.getElementById('count-known').innerText = known;
    document.getElementById('count-unknown').innerText = unknown;
}

function updateUndoButton() {
    document.getElementById('btn-undo').disabled = actionHistory.length === 0;
}

function updateSrsToggleUI() {
    const on = isSrsEnabled();
    const btn = document.getElementById('btn-srs-toggle');
    btn.innerText = on ? '🧠 SRS: BẬT' : '🧠 SRS: TẮT';
    btn.classList.toggle('btn-tool-active', on);
    document.getElementById('action-btns').style.display = on ? 'none' : 'flex';
    document.getElementById('srs-btns').style.display = on ? 'flex' : 'none';
}

function renderCard() {
    if (srsFilteredEmpty && currentIndex >= currentQueue.length) {
        document.getElementById('card-nav-wrapper').style.display = 'none';
        document.getElementById('action-btns').style.display = 'none';
        document.getElementById('srs-btns').style.display = 'none';
        document.getElementById('counter-stats').style.display = 'none';
        document.getElementById('complete-screen').style.display = 'none';
        document.getElementById('srs-empty-screen').style.display = 'block';
        document.getElementById('stats').innerText = '';
        return;
    }
    document.getElementById('srs-empty-screen').style.display = 'none';

    if (!currentQueue || currentQueue.length === 0 || currentIndex >= currentQueue.length) {
        document.getElementById('card-nav-wrapper').style.display = 'none';
        document.getElementById('action-btns').style.display = 'none';
        document.getElementById('srs-btns').style.display = 'none';
        document.getElementById('counter-stats').style.display = 'none';

        if (currentQueue && currentQueue.length > 0) {
            document.getElementById('complete-screen').style.display = 'block';
        } else {
            document.getElementById('stats').innerText = "Chưa có từ nào trong danh mục này.";
        }
        clearSession();
        return;
    }

    document.getElementById('card-scene').classList.remove('is-flipped');
    const card = currentQueue[currentIndex];
    document.getElementById('stats').innerText = `Thẻ ${currentIndex + 1} / ${currentQueue.length}`;

    document.getElementById('btn-prev').disabled = currentIndex === 0;
    document.getElementById('btn-next').disabled = currentIndex >= currentQueue.length - 1;

    const kanji = card.kanji || '';
    const furigana = card.furigana || '';
    const hanviet = card.hanviet || card['han-viet'] || '';
    const meaning = card.meaning || '';
    const example = card.example || '';

    if (kanji) {
        const furiganaHtml = (furigana && isFuriganaVisible()) ? `<p>(${furigana})</p>` : '';
        document.getElementById('card-front').innerHTML = `<h3>${kanji}</h3>${furiganaHtml}${speakBtnHtml(card)}`;
    } else {
        document.getElementById('card-front').innerHTML = `<h3>${card.structure || ''}</h3>${speakBtnHtml(card)}`;
    }

    let backHtml = '';
    if (hanviet) backHtml += `<p><strong>Hán Việt:</strong> ${hanviet}</p>`;
    if (meaning) backHtml += `<p style="white-space: pre-line;"><strong>Nghĩa:</strong> ${meaning}</p>`;
    if (example) backHtml += `<p style="white-space: pre-line;"><small style="color: var(--card-back-muted);">${example}</small></p>`;

    document.getElementById('card-back').innerHTML = speakBtnHtml(card) + (backHtml || '<p>Chưa có chi tiết</p>');

    updateUndoButton();
    saveSession();
}

function flipCard() {
    document.getElementById('card-scene').classList.toggle('is-flipped');
}

function handleCardClick() {
    if (justSwiped) { justSwiped = false; return; }
    flipCard();
}

// ==== Confetti khi đạt 100% một cấp độ ====
let cachedTotalCounts = null;
function checkLevelCompleteConfetti() {
    if (isLearnedMode) return; // trang xem lại "đã thuộc" không cần bắn confetti
    const learnedTotal = learnedCount();

    function fireIfDone(total) {
        if (total > 0 && learnedTotal >= total) {
            if (localStorage.getItem(confettiFlagKey) !== '1') {
                localStorage.setItem(confettiFlagKey, '1');
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 } });
                    setTimeout(() => confetti({ particleCount: 100, spread: 120, origin: { y: 0.4 } }), 300);
                }
            }
        } else {
            localStorage.removeItem(confettiFlagKey);
        }
    }

    if (cachedTotalCounts) {
        fireIfDone((cachedTotalCounts[typeKey] && cachedTotalCounts[typeKey][levelKey]) || 0);
        return;
    }
    fetch('/api/counts').then(r => r.json()).then(counts => {
        cachedTotalCounts = counts;
        fireIfDone((counts[typeKey] && counts[typeKey][levelKey]) || 0);
    }).catch(() => {});
}

// ==== Đánh dấu thẻ: chế độ thường (2 trạng thái) ====
// Đánh dấu lại một thẻ đã có verdict trước đó (VD: bấm ← quay lại rồi đổi ý) sẽ THAY THẾ
// verdict cũ chứ không cộng dồn, nhờ sessionVerdict[id] chỉ giữ giá trị mới nhất.
function markCard(isKnown) {
    const currentCard = currentQueue[currentIndex];
    if (!currentCard) return;
    const scene = document.getElementById('card-scene');
    scene.classList.add('slide-next');

    const entry = {
        index: currentIndex,
        card: currentCard,
        mode: 'simple',
        prevLearned: isInLearned(currentCard.id),
        prevUnlearned: isInUnlearned(currentCard.id),
        prevVerdict: sessionVerdict[currentCard.id] // undefined nếu đây là lần đầu đánh dấu thẻ này
    };

    sessionVerdict[currentCard.id] = isKnown ? 'known' : 'unknown';

    if (!isKnown) {
        saveToUnlearned(currentCard);
        removeFromLearned(currentCard.id);
    } else {
        saveToLearned(currentCard);
        removeFromUnlearned(currentCard.id);
    }

    actionHistory.push(entry);
    updateCounters();
    checkLevelCompleteConfetti();

    setTimeout(() => { currentIndex++; renderCard(); }, 180);
    setTimeout(() => { scene.classList.remove('slide-next'); }, 350);
}

// ==== Đánh giá thẻ: chế độ SRS (4 mức độ kiểu Anki) ====
function gradeCard(grade) {
    const currentCard = currentQueue[currentIndex];
    if (!currentCard) return;
    const scene = document.getElementById('card-scene');
    scene.classList.add('slide-next');

    const isKnown = grade >= 2;
    const entry = {
        index: currentIndex,
        card: currentCard,
        mode: 'srs',
        prevLearned: isInLearned(currentCard.id),
        prevUnlearned: isInUnlearned(currentCard.id),
        prevSrs: srsData[currentCard.id] ? { ...srsData[currentCard.id] } : null,
        prevVerdict: sessionVerdict[currentCard.id]
    };

    applySrsGrade(currentCard, grade);
    sessionVerdict[currentCard.id] = isKnown ? 'known' : 'unknown';

    if (!isKnown) {
        saveToUnlearned(currentCard);
        removeFromLearned(currentCard.id);
    } else {
        saveToLearned(currentCard);
        removeFromUnlearned(currentCard.id);
    }

    actionHistory.push(entry);
    updateCounters();
    checkLevelCompleteConfetti();

    setTimeout(() => { currentIndex++; renderCard(); }, 180);
    setTimeout(() => { scene.classList.remove('slide-next'); }, 350);
}

// ==== Hoàn tác (Undo) ====
function undoLast() {
    const entry = actionHistory.pop();
    if (!entry) return;

    if (entry.prevLearned) saveToLearned(entry.card); else removeFromLearned(entry.card.id);
    if (entry.prevUnlearned) saveToUnlearned(entry.card); else removeFromUnlearned(entry.card.id);

    if (entry.mode === 'srs') {
        if (entry.prevSrs) srsData[entry.card.id] = entry.prevSrs;
        else delete srsData[entry.card.id];
        saveSrsData();
    }

    if (entry.prevVerdict === undefined) delete sessionVerdict[entry.card.id];
    else sessionVerdict[entry.card.id] = entry.prevVerdict;

    currentIndex = entry.index;
    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    document.getElementById('srs-empty-screen').style.display = 'none';
    updateSrsToggleUI();
    updateCounters();
    renderCard();
}

// ==== Trộn thẻ (chỉ trộn các thẻ CHƯA xem, giữ nguyên các thẻ đã đi qua) ====
function shuffleRemaining() {
    const head = currentQueue.slice(0, currentIndex);
    const tail = currentQueue.slice(currentIndex);
    for (let i = tail.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [tail[i], tail[j]] = [tail[j], tail[i]];
    }
    currentQueue = head.concat(tail);
    saveSession();
    renderCard();
}

function prevCard() {
    if (currentIndex > 0) { currentIndex--; renderCard(); }
}
function nextCard() {
    if (currentQueue && currentIndex < currentQueue.length - 1) { currentIndex++; renderCard(); }
}

function toggleSrs(forceValue) {
    const newVal = (typeof forceValue === 'boolean') ? forceValue : !isSrsEnabled();
    setSrsEnabled(newVal);
    clearSession();
    currentQueue = buildInitialQueue();
    registerCards(currentQueue);
    srsFilteredEmpty = (currentQueue.length === 0 && !isLearnedMode && newVal &&
        (isUnlearnedMode ? getSavedUnlearned().length > 0 : originalCards.length > 0));
    sessionVerdict = {};
    currentIndex = 0;
    actionHistory = [];
    updateSrsToggleUI();
    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    updateCounters();
    renderCard();
}

function restart(onlyUnlearned) {
    if (onlyUnlearned) {
        currentQueue = Object.keys(sessionVerdict)
            .filter(id => sessionVerdict[id] === 'unknown')
            .map(id => cardsById[id])
            .filter(Boolean);
    } else {
        currentQueue = buildInitialQueue();
    }
    registerCards(currentQueue);
    srsFilteredEmpty = false;
    sessionVerdict = {};
    currentIndex = 0;
    actionHistory = [];
    updateCounters();
    updateUndoButton();

    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('srs-empty-screen').style.display = 'none';
    updateSrsToggleUI();
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    renderCard();
}

document.getElementById('btn-shuffle').addEventListener('click', shuffleRemaining);
document.getElementById('btn-undo').addEventListener('click', undoLast);
document.getElementById('btn-srs-toggle').addEventListener('click', () => toggleSrs());
document.getElementById('btn-toggle-furigana').addEventListener('click', () => {
    setFuriganaVisible(!isFuriganaVisible());
    updateFuriganaToggleUI();
    renderCard(); // vẽ lại thẻ hiện tại ngay để thấy hiệu quả tức thì
});
document.getElementById('btn-reset-session').addEventListener('click', () => {
    clearSession();
    restart(false);
});

// ==== Xoá vĩnh viễn toàn bộ tiến độ (Đã thuộc / Chưa thuộc / SRS) của type+level này ====
// Khác với "Học lại từ đầu" (chỉ reset lượt xem hiện tại), nút này xoá luôn tiến độ trên DB.
async function clearAllProgress() {
    const confirmed = window.confirm(
        `Thao tác này sẽ XOÁ VĨNH VIỄN:\n` +
        `- Toàn bộ danh sách "Đã thuộc" và "Chưa thuộc"\n` +
        `- Toàn bộ lịch ôn tập SRS\n` +
        `của mục ${typeKey.toUpperCase()} - ${levelKey.toUpperCase()}.\n\n` +
        `Bạn có chắc chắn muốn tiếp tục không?`
    );
    if (!confirmed) return;

    try {
        if (isLoggedIn) {
            await writeChain; // đợi các thao tác ghi đang chờ xong, tránh bị ghi đè ngược lại
            await api('DELETE', `/api/progress/${typeKey}/${levelKey}`);
        }
    } catch (e) {
        console.error(e);
        showSyncError('Không xoá được tiến độ trên máy chủ. Thử lại sau.');
        return;
    }

    Object.keys(progressMap).forEach(k => delete progressMap[k]);
    // Xoá luôn key cũ trong localStorage, nếu không lần tải sau sẽ bị "chuyển lên DB" lại
    clearLocalProgress();
    localStorage.removeItem(srsStorageKey);
    localStorage.removeItem(srsEnabledKey);
    localStorage.removeItem(confettiFlagKey);
    clearSession();

    srsData = {};
    restart(false);
}
document.getElementById('btn-clear-all').addEventListener('click', clearAllProgress);

// ==== Phím tắt bàn phím ====
document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement && document.activeElement.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (document.getElementById('card-nav-wrapper').style.display === 'none') return;

    if (e.code === 'Space' || e.key === 'Enter') {
        e.preventDefault();
        flipCard();
    } else if (e.key === 'ArrowLeft') {
        prevCard();
    } else if (e.key === 'ArrowRight') {
        nextCard();
    } else if (isSrsEnabled()) {
        if (e.key === '1') gradeCard(0);
        else if (e.key === '2') gradeCard(1);
        else if (e.key === '3') gradeCard(2);
        else if (e.key === '4') gradeCard(3);
    } else {
        if (e.key === '1') markCard(false);
        else if (e.key === '2') markCard(true);
    }
});

// ==== Vuốt trên mobile (swipe kiểu Tinder) ====
const scene = document.getElementById('card-scene');
const cardInner = document.getElementById('card-inner');
let touchStartX = 0, touchStartY = 0, touchDX = 0, isDragging = false, justSwiped = false;
const SWIPE_THRESHOLD = 80;

scene.addEventListener('touchstart', (e) => {
    if (!e.touches || e.touches.length !== 1) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchDX = 0;
    isDragging = true;
    cardInner.style.transition = 'none';
}, { passive: true });

scene.addEventListener('touchmove', (e) => {
    if (!isDragging || !e.touches || e.touches.length !== 1) return;
    const dx = e.touches[0].clientX - touchStartX;
    const dy = e.touches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
        touchDX = dx;
        const rot = Math.max(-15, Math.min(15, dx / 10));
        cardInner.style.transform = `translateX(${dx}px) rotate(${rot}deg)`;
        document.getElementById('swipe-hint-left').style.opacity = dx < -20 ? Math.min(1, -dx / SWIPE_THRESHOLD) : 0;
        document.getElementById('swipe-hint-right').style.opacity = dx > 20 ? Math.min(1, dx / SWIPE_THRESHOLD) : 0;
    }
}, { passive: true });

scene.addEventListener('touchend', () => {
    if (!isDragging) return;
    isDragging = false;
    cardInner.style.transition = '';
    document.getElementById('swipe-hint-left').style.opacity = 0;
    document.getElementById('swipe-hint-right').style.opacity = 0;

    if (Math.abs(touchDX) >= SWIPE_THRESHOLD) {
        justSwiped = true;
        const known = touchDX > 0;
        cardInner.style.transform = `translateX(${known ? 600 : -600}px) rotate(${known ? 20 : -20}deg)`;
        setTimeout(() => {
            cardInner.style.transform = '';
            if (isSrsEnabled()) gradeCard(known ? 2 : 0);
            else markCard(known);
        }, 150);
    } else {
        cardInner.style.transform = '';
    }
    touchDX = 0;
});

// ==== Khởi chạy: tải tiến trình + vị trí đang học từ DB rồi mới vẽ thẻ ====
async function init() {
    updateSrsToggleUI();
    updateFuriganaToggleUI();
    updateCounters();
    updateUndoButton();
    if (isLoggedIn) document.getElementById('stats').innerText = 'Đang tải tiến trình...';

    if (isLoggedIn) {
        try {
            const rows = await api('GET', `/api/progress/${typeKey}/${levelKey}`);
            rows.forEach(r => { progressMap[String(r.card_id)] = r.status; });
            await migrateLocalToDb();
        } catch (e) {
            console.error('Không tải được tiến trình:', e);
            showSyncError('Không tải được tiến trình từ máy chủ.');
        }
    } else {
        loadGuestProgress();
    }

    currentQueue = buildInitialQueue();
    registerCards(currentQueue);
    srsFilteredEmpty = (currentQueue.length === 0 && !isLearnedMode && isSrsEnabled() &&
        (isUnlearnedMode ? getSavedUnlearned().length > 0 : originalCards.length > 0));

    restoreSession(await loadSession());

    ready = true;
    updateCounters();
    updateUndoButton();
    renderCard();
}
init();
    </script>
