<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Học <%= type %> - <%= level.toUpperCase() %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1/dist/confetti.browser.min.js"></script>
</head>
<body>
    <%- include('index.ejs') %>

    <div class="container" id="app">
        <h2>
            <%= isUnlearned ? '⚠️ Đang ôn (chưa thuộc):' : (isLearned ? '✅ Xem lại (đã thuộc):' : 'Đang học:') %>
            <%= type.toUpperCase() %> - <%= level.toUpperCase() %>
        </h2>

        <div id="stats" style="font-weight: 700; color: #6b7280; margin-bottom: 6px; letter-spacing: 0.3px;"></div>

        <!-- Thanh công cụ: Trộn thẻ / Hoàn tác / SRS / Học lại từ đầu -->
        <div class="toolbar" id="toolbar">
            <button class="btn-tool" id="btn-shuffle" title="Trộn ngẫu nhiên các thẻ chưa xem">🔀 Trộn thẻ</button>
            <button class="btn-tool" id="btn-undo" title="Hoàn tác thao tác vừa rồi" disabled>↩️ Hoàn tác</button>
            <button class="btn-tool" id="btn-srs-toggle" title="Bật/tắt chế độ Spaced Repetition (SM-2)">🧠 SRS: TẮT</button>
            <button class="btn-tool btn-tool-ghost" id="btn-reset-session" title="Xoá tiến trình phiên này và học lại từ đầu">↺ Học lại từ đầu</button>
            <button class="btn-tool btn-tool-danger" id="btn-clear-all" title="Xoá vĩnh viễn toàn bộ Đã thuộc / Chưa thuộc / lịch SRS của mục này">🗑️ Xoá tiến độ</button>
        </div>

        <!-- Khung 3D Flashcard + Nút điều hướng Trước / Sau -->
        <div class="card-nav-wrapper" id="card-nav-wrapper">
            <button class="nav-arrow nav-arrow-left" id="btn-prev" onclick="prevCard()" title="Thẻ trước (←)" aria-label="Thẻ trước">&#8249;</button>

            <div class="card-scene" id="card-scene" onclick="handleCardClick()">
                <div class="card-inner" id="card-inner">
                    <div class="card-front" id="card-front"></div>
                    <div class="card-back" id="card-back"></div>
                </div>
                <div class="swipe-hint swipe-hint-left" id="swipe-hint-left">CHƯA THUỘC</div>
                <div class="swipe-hint swipe-hint-right" id="swipe-hint-right">ĐÃ THUỘC</div>
            </div>

            <button class="nav-arrow nav-arrow-right" id="btn-next" onclick="nextCard()" title="Thẻ tiếp theo (→)" aria-label="Thẻ tiếp theo">&#8250;</button>
        </div>

        <div class="hint-row">Space/Enter: lật thẻ · ←/→: chuyển thẻ · 1/2: đánh dấu · vuốt trái/phải trên di động · đánh dấu lại một thẻ sẽ luôn thay thế lượt trước đó</div>

        <div class="btn-group" id="action-btns">
            <button class="btn btn-danger" id="btn-mark-unknown" onclick="markCard(false)">Chưa thuộc <span class="kbd-hint">1</span></button>
            <button class="btn btn-success" id="btn-mark-known" onclick="markCard(true)">Đã thuộc <span class="kbd-hint">2</span></button>
        </div>

        <div class="btn-group srs-btn-group" id="srs-btns" style="display:none;">
            <button class="btn btn-srs btn-srs-again" onclick="gradeCard(0)">Lại <span class="kbd-hint">1</span></button>
            <button class="btn btn-srs btn-srs-hard" onclick="gradeCard(1)">Khó <span class="kbd-hint">2</span></button>
            <button class="btn btn-srs btn-srs-good" onclick="gradeCard(2)">Tốt <span class="kbd-hint">3</span></button>
            <button class="btn btn-srs btn-srs-easy" onclick="gradeCard(3)">Dễ <span class="kbd-hint">4</span></button>
        </div>

        <div id="counter-stats" style="margin-top: 18px; display: flex; justify-content: center; gap: 12px; font-weight: 700;">
            <span style="color: #1f6f52;">Đã thuộc: <span id="count-known">0</span></span>
            <span style="color: #8f3b46;">Chưa thuộc: <span id="count-unknown">0</span></span>
        </div>

        <!-- Màn hình không còn thẻ nào cần ôn hôm nay (chế độ SRS) -->
        <div id="srs-empty-screen" style="display: none;">
            <h3>🎉 Không còn thẻ nào cần ôn hôm nay!</h3>
            <p style="color: var(--ink-soft);">Các thẻ sẽ tự động quay lại đúng lịch (SM-2) khi đến hạn ôn tập.</p>
            <div class="btn-group">
                <button class="btn btn-primary" onclick="toggleSrs(false)">Tắt SRS, học toàn bộ ngay</button>
            </div>
        </div>

        <!-- Màn hình hoàn thành -->
        <div id="complete-screen" style="display: none;">
            <h3>🎉 Bạn đã hoàn thành lượt học!</h3>
            <div class="btn-group">
                <button class="btn btn-primary" onclick="restart(false)">Học lại toàn bộ</button>
                <button class="btn btn-danger" onclick="restart(true)">Chỉ học lại các từ CHƯA THUỘC</button>
            </div>
        </div>
    </div>

    <script>
const typeKey = '<%= type %>';
const levelKey = '<%= level %>';
const isUnlearnedMode = <%= isUnlearned %>;
const isLearnedMode = <%= isLearned %>;
const modeKey = isLearnedMode ? 'learned' : (isUnlearnedMode ? 'unlearned' : 'normal');
const storageKey = `unlearned_${typeKey}_${levelKey}`;
const learnedStorageKey = `learned_${typeKey}_${levelKey}`;
const srsStorageKey = `srs_${typeKey}_${levelKey}`;
const srsEnabledKey = `srsEnabled_${typeKey}_${levelKey}`;
const sessionKey = `session_${typeKey}_${levelKey}_${modeKey}`;
const confettiFlagKey = `confetti_done_${typeKey}_${levelKey}`;

// Lấy dữ liệu gốc từ Server
const originalCards = <%- JSON.stringify(cards) %>;

// ==== Quản lý LocalStorage: CHƯA THUỘC ====
function getSavedUnlearned() {
    try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch (e) { return []; }
}
function saveToUnlearned(card) {
    let list = getSavedUnlearned();
    if (!list.some(c => c.id === card.id)) {
        list.push(card);
        localStorage.setItem(storageKey, JSON.stringify(list));
    }
}
function removeFromUnlearned(cardId) {
    let list = getSavedUnlearned().filter(c => c.id !== cardId);
    localStorage.setItem(storageKey, JSON.stringify(list));
}
function isInUnlearned(cardId) {
    return getSavedUnlearned().some(c => c.id === cardId);
}

// ==== Quản lý LocalStorage: ĐÃ THUỘC ====
function getSavedLearned() {
    try { return JSON.parse(localStorage.getItem(learnedStorageKey) || '[]'); } catch (e) { return []; }
}
function saveToLearned(card) {
    let list = getSavedLearned();
    if (!list.some(c => c.id === card.id)) {
        list.push(card);
        localStorage.setItem(learnedStorageKey, JSON.stringify(list));
    }
}
function removeFromLearned(cardId) {
    let list = getSavedLearned().filter(c => c.id !== cardId);
    localStorage.setItem(learnedStorageKey, JSON.stringify(list));
}
function isInLearned(cardId) {
    return getSavedLearned().some(c => c.id === cardId);
}

// ==== Ghi nhận ngày học (dùng cho streak ở trang Dashboard) ====
function markStudyToday() {
    try {
        const today = new Date().toISOString().slice(0, 10);
        let dates = JSON.parse(localStorage.getItem('studyDates') || '[]');
        if (!dates.includes(today)) {
            dates.push(today);
            localStorage.setItem('studyDates', JSON.stringify(dates));
        }
    } catch (e) { /* ignore */ }
}
markStudyToday();

// ==== SRS (Spaced Repetition kiểu SM-2 đơn giản hoá) ====
function getSrsData() {
    try { return JSON.parse(localStorage.getItem(srsStorageKey) || '{}'); } catch (e) { return {}; }
}
let srsData = getSrsData();
function saveSrsData() { localStorage.setItem(srsStorageKey, JSON.stringify(srsData)); }

function isSrsEnabled() { return localStorage.getItem(srsEnabledKey) === '1'; }
function setSrsEnabled(val) { localStorage.setItem(srsEnabledKey, val ? '1' : '0'); }

function todayStr() { return new Date().toISOString().slice(0, 10); }

// Cập nhật lịch ôn tập cho 1 thẻ theo thuật toán SM-2 (grade: 0 Lại, 1 Khó, 2 Tốt, 3 Dễ)
function applySrsGrade(card, grade) {
    let data = srsData[card.id] || { ef: 2.5, interval: 0, reps: 0 };
    if (grade === 0) {
        data.reps = 0;
        data.interval = 1;
        data.ef = Math.max(1.3, data.ef - 0.2);
    } else {
        const q = grade === 1 ? 3 : (grade === 2 ? 4 : 5);
        data.ef = Math.max(1.3, data.ef + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02)));
        data.reps += 1;
        if (data.reps === 1) data.interval = 1;
        else if (data.reps === 2) data.interval = 6;
        else data.interval = Math.round(data.interval * data.ef);
        if (grade === 1) data.interval = Math.max(1, Math.round(data.interval * 0.7));
    }
    const due = new Date();
    due.setDate(due.getDate() + data.interval);
    data.due = due.toISOString().slice(0, 10);
    srsData[card.id] = data;
    saveSrsData();
}

function isDueToday(card) {
    const d = srsData[card.id];
    if (!d || !d.due) return true; // chưa từng ôn -> luôn tính là đến hạn
    return d.due <= todayStr();
}

// Biến khởi tạo: chọn nguồn hàng đợi theo chế độ đang xem
function buildInitialQueue() {
    let base;
    if (isLearnedMode) base = getSavedLearned();
    else if (isUnlearnedMode) base = getSavedUnlearned();
    else base = [...originalCards];

    if (!isLearnedMode && isSrsEnabled()) {
        return base.filter(isDueToday);
    }
    return base;
}

// cardsById: tra cứu thẻ theo id (phục vụ "restart chỉ học lại từ chưa thuộc" và khôi phục session)
let cardsById = {};
function registerCards(list) {
    (list || []).forEach(c => { if (c && c.id != null) cardsById[c.id] = c; });
}
registerCards(originalCards);

let srsFilteredEmpty = false;
let currentQueue = buildInitialQueue();
registerCards(currentQueue);
srsFilteredEmpty = (currentQueue.length === 0 && !isLearnedMode && isSrsEnabled() &&
    (isUnlearnedMode ? getSavedUnlearned().length > 0 : originalCards.length > 0));

let currentIndex = 0;

// sessionVerdict: id -> 'known' | 'unknown' — PHÁN QUYẾT MỚI NHẤT của mỗi thẻ trong phiên này.
// Đánh dấu lại một thẻ (sau khi bấm ← quay lại) sẽ GHI ĐÈ verdict cũ, không cộng dồn -> tránh đếm trùng.
let sessionVerdict = {};
let actionHistory = [];

function computeCounts() {
    let known = 0, unknown = 0;
    Object.keys(sessionVerdict).forEach(id => {
        if (sessionVerdict[id] === 'known') known++;
        else if (sessionVerdict[id] === 'unknown') unknown++;
    });
    return { known, unknown };
}

// ==== Lưu / khôi phục tiến trình (fix lỗi reload về 0) ====
function saveSession() {
    try {
        const payload = {
            orderIds: currentQueue.map(c => c.id),
            currentIndex: currentIndex,
            sessionVerdict: sessionVerdict,
            srsOn: isSrsEnabled(),
            ts: Date.now()
        };
        localStorage.setItem(sessionKey, JSON.stringify(payload));
    } catch (e) { /* ignore */ }
}

function clearSession() {
    localStorage.removeItem(sessionKey);
}

function restoreSession() {
    let saved;
    try { saved = JSON.parse(localStorage.getItem(sessionKey) || 'null'); } catch (e) { saved = null; }
    if (!saved || !Array.isArray(saved.orderIds)) return;
    if (saved.srsOn !== isSrsEnabled()) return; // chế độ SRS thay đổi -> hàng đợi khác, bỏ qua khôi phục

    const byId = {};
    currentQueue.forEach(c => { byId[c.id] = c; });
    const freshIds = new Set(currentQueue.map(c => c.id));
    const savedIdsPresent = saved.orderIds.filter(id => freshIds.has(id));

    // Chỉ khôi phục nếu tập thẻ (theo id) về cơ bản trùng khớp với hàng đợi vừa build
    if (savedIdsPresent.length === 0 || savedIdsPresent.length !== currentQueue.length) return;

    const reordered = savedIdsPresent.map(id => byId[id]);
    currentQueue.forEach(c => { if (!savedIdsPresent.includes(c.id)) reordered.push(c); });

    currentQueue = reordered;
    currentIndex = Math.min(saved.currentIndex || 0, currentQueue.length);

    sessionVerdict = {};
    if (saved.sessionVerdict && typeof saved.sessionVerdict === 'object') {
        Object.keys(saved.sessionVerdict).forEach(id => {
            if (freshIds.has(id)) sessionVerdict[id] = saved.sessionVerdict[id];
        });
    }
}

restoreSession();

function updateCounters() {
    const { known, unknown } = computeCounts();
    document.getElementById('count-known').innerText = known;
    document.getElementById('count-unknown').innerText = unknown;
}

function updateUndoButton() {
    document.getElementById('btn-undo').disabled = actionHistory.length === 0;
}

function updateSrsToggleUI() {
    const on = isSrsEnabled();
    const btn = document.getElementById('btn-srs-toggle');
    btn.innerText = on ? '🧠 SRS: BẬT' : '🧠 SRS: TẮT';
    btn.classList.toggle('btn-tool-active', on);
    document.getElementById('action-btns').style.display = on ? 'none' : 'flex';
    document.getElementById('srs-btns').style.display = on ? 'flex' : 'none';
}

function renderCard() {
    if (srsFilteredEmpty && currentIndex >= currentQueue.length) {
        document.getElementById('card-nav-wrapper').style.display = 'none';
        document.getElementById('action-btns').style.display = 'none';
        document.getElementById('srs-btns').style.display = 'none';
        document.getElementById('counter-stats').style.display = 'none';
        document.getElementById('complete-screen').style.display = 'none';
        document.getElementById('srs-empty-screen').style.display = 'block';
        document.getElementById('stats').innerText = '';
        return;
    }
    document.getElementById('srs-empty-screen').style.display = 'none';

    if (!currentQueue || currentQueue.length === 0 || currentIndex >= currentQueue.length) {
        document.getElementById('card-nav-wrapper').style.display = 'none';
        document.getElementById('action-btns').style.display = 'none';
        document.getElementById('srs-btns').style.display = 'none';
        document.getElementById('counter-stats').style.display = 'none';

        if (currentQueue && currentQueue.length > 0) {
            document.getElementById('complete-screen').style.display = 'block';
        } else {
            document.getElementById('stats').innerText = "Chưa có từ nào trong danh mục này.";
        }
        clearSession();
        return;
    }

    document.getElementById('card-scene').classList.remove('is-flipped');
    const card = currentQueue[currentIndex];
    document.getElementById('stats').innerText = `Thẻ ${currentIndex + 1} / ${currentQueue.length}`;

    document.getElementById('btn-prev').disabled = currentIndex === 0;
    document.getElementById('btn-next').disabled = currentIndex >= currentQueue.length - 1;

    const kanji = card.kanji || '';
    const furigana = card.furigana || '';
    const hanviet = card.hanviet || card['han-viet'] || '';
    const meaning = card.meaning || '';
    const example = card.example || '';

    if (kanji) {
        document.getElementById('card-front').innerHTML = `<h3>${kanji}</h3><p>(${furigana})</p>`;
    } else {
        document.getElementById('card-front').innerHTML = `<h3>${card.structure || ''}</h3>`;
    }

    let backHtml = '';
    if (hanviet) backHtml += `<p><strong>Hán Việt:</strong> ${hanviet}</p>`;
    if (meaning) backHtml += `<p><strong>Nghĩa:</strong> ${meaning}</p>`;
    if (example) backHtml += `<p><small style="color: #475569;">${example}</small></p>`;

    document.getElementById('card-back').innerHTML = backHtml || '<p>Chưa có chi tiết</p>';

    updateUndoButton();
    saveSession();
}

function flipCard() {
    document.getElementById('card-scene').classList.toggle('is-flipped');
}

function handleCardClick() {
    if (justSwiped) { justSwiped = false; return; }
    flipCard();
}

// ==== Confetti khi đạt 100% một cấp độ ====
let cachedTotalCounts = null;
function checkLevelCompleteConfetti() {
    if (isLearnedMode) return; // trang xem lại "đã thuộc" không cần bắn confetti
    const learnedTotal = getSavedLearned().length;

    function fireIfDone(total) {
        if (total > 0 && learnedTotal >= total) {
            if (localStorage.getItem(confettiFlagKey) !== '1') {
                localStorage.setItem(confettiFlagKey, '1');
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 160, spread: 80, origin: { y: 0.6 } });
                    setTimeout(() => confetti({ particleCount: 100, spread: 120, origin: { y: 0.4 } }), 300);
                }
            }
        } else {
            localStorage.removeItem(confettiFlagKey);
        }
    }

    if (cachedTotalCounts) {
        fireIfDone((cachedTotalCounts[typeKey] && cachedTotalCounts[typeKey][levelKey]) || 0);
        return;
    }
    fetch('/api/counts').then(r => r.json()).then(counts => {
        cachedTotalCounts = counts;
        fireIfDone((counts[typeKey] && counts[typeKey][levelKey]) || 0);
    }).catch(() => {});
}

// ==== Đánh dấu thẻ: chế độ thường (2 trạng thái) ====
// Đánh dấu lại một thẻ đã có verdict trước đó (VD: bấm ← quay lại rồi đổi ý) sẽ THAY THẾ
// verdict cũ chứ không cộng dồn, nhờ sessionVerdict[id] chỉ giữ giá trị mới nhất.
function markCard(isKnown) {
    const currentCard = currentQueue[currentIndex];
    if (!currentCard) return;
    const scene = document.getElementById('card-scene');
    scene.classList.add('slide-next');

    const entry = {
        index: currentIndex,
        card: currentCard,
        mode: 'simple',
        prevLearned: isInLearned(currentCard.id),
        prevUnlearned: isInUnlearned(currentCard.id),
        prevVerdict: sessionVerdict[currentCard.id] // undefined nếu đây là lần đầu đánh dấu thẻ này
    };

    sessionVerdict[currentCard.id] = isKnown ? 'known' : 'unknown';

    if (!isKnown) {
        saveToUnlearned(currentCard);
        removeFromLearned(currentCard.id);
    } else {
        saveToLearned(currentCard);
        removeFromUnlearned(currentCard.id);
    }

    actionHistory.push(entry);
    updateCounters();
    checkLevelCompleteConfetti();

    setTimeout(() => { currentIndex++; renderCard(); }, 180);
    setTimeout(() => { scene.classList.remove('slide-next'); }, 350);
}

// ==== Đánh giá thẻ: chế độ SRS (4 mức độ kiểu Anki) ====
function gradeCard(grade) {
    const currentCard = currentQueue[currentIndex];
    if (!currentCard) return;
    const scene = document.getElementById('card-scene');
    scene.classList.add('slide-next');

    const isKnown = grade >= 2;
    const entry = {
        index: currentIndex,
        card: currentCard,
        mode: 'srs',
        prevLearned: isInLearned(currentCard.id),
        prevUnlearned: isInUnlearned(currentCard.id),
        prevSrs: srsData[currentCard.id] ? { ...srsData[currentCard.id] } : null,
        prevVerdict: sessionVerdict[currentCard.id]
    };

    applySrsGrade(currentCard, grade);
    sessionVerdict[currentCard.id] = isKnown ? 'known' : 'unknown';

    if (!isKnown) {
        saveToUnlearned(currentCard);
        removeFromLearned(currentCard.id);
    } else {
        saveToLearned(currentCard);
        removeFromUnlearned(currentCard.id);
    }

    actionHistory.push(entry);
    updateCounters();
    checkLevelCompleteConfetti();

    setTimeout(() => { currentIndex++; renderCard(); }, 180);
    setTimeout(() => { scene.classList.remove('slide-next'); }, 350);
}

// ==== Hoàn tác (Undo) ====
function undoLast() {
    const entry = actionHistory.pop();
    if (!entry) return;

    if (entry.prevLearned) saveToLearned(entry.card); else removeFromLearned(entry.card.id);
    if (entry.prevUnlearned) saveToUnlearned(entry.card); else removeFromUnlearned(entry.card.id);

    if (entry.mode === 'srs') {
        if (entry.prevSrs) srsData[entry.card.id] = entry.prevSrs;
        else delete srsData[entry.card.id];
        saveSrsData();
    }

    if (entry.prevVerdict === undefined) delete sessionVerdict[entry.card.id];
    else sessionVerdict[entry.card.id] = entry.prevVerdict;

    currentIndex = entry.index;
    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    document.getElementById('srs-empty-screen').style.display = 'none';
    updateSrsToggleUI();
    updateCounters();
    renderCard();
}

// ==== Trộn thẻ (chỉ trộn các thẻ CHƯA xem, giữ nguyên các thẻ đã đi qua) ====
function shuffleRemaining() {
    const head = currentQueue.slice(0, currentIndex);
    const tail = currentQueue.slice(currentIndex);
    for (let i = tail.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [tail[i], tail[j]] = [tail[j], tail[i]];
    }
    currentQueue = head.concat(tail);
    saveSession();
    renderCard();
}

function prevCard() {
    if (currentIndex > 0) { currentIndex--; renderCard(); }
}
function nextCard() {
    if (currentQueue && currentIndex < currentQueue.length - 1) { currentIndex++; renderCard(); }
}

function toggleSrs(forceValue) {
    const newVal = (typeof forceValue === 'boolean') ? forceValue : !isSrsEnabled();
    setSrsEnabled(newVal);
    clearSession();
    currentQueue = buildInitialQueue();
    registerCards(currentQueue);
    srsFilteredEmpty = (currentQueue.length === 0 && !isLearnedMode && newVal &&
        (isUnlearnedMode ? getSavedUnlearned().length > 0 : originalCards.length > 0));
    sessionVerdict = {};
    currentIndex = 0;
    actionHistory = [];
    updateSrsToggleUI();
    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    updateCounters();
    renderCard();
}

function restart(onlyUnlearned) {
    if (onlyUnlearned) {
        currentQueue = Object.keys(sessionVerdict)
            .filter(id => sessionVerdict[id] === 'unknown')
            .map(id => cardsById[id])
            .filter(Boolean);
    } else {
        currentQueue = buildInitialQueue();
    }
    registerCards(currentQueue);
    srsFilteredEmpty = false;
    sessionVerdict = {};
    currentIndex = 0;
    actionHistory = [];
    updateCounters();
    updateUndoButton();

    document.getElementById('card-nav-wrapper').style.display = 'flex';
    document.getElementById('srs-empty-screen').style.display = 'none';
    updateSrsToggleUI();
    document.getElementById('counter-stats').style.display = 'flex';
    document.getElementById('complete-screen').style.display = 'none';
    renderCard();
}

document.getElementById('btn-shuffle').addEventListener('click', shuffleRemaining);
document.getElementById('btn-undo').addEventListener('click', undoLast);
document.getElementById('btn-srs-toggle').addEventListener('click', () => toggleSrs());
document.getElementById('btn-reset-session').addEventListener('click', () => {
    clearSession();
    restart(false);
});

// ==== Xoá vĩnh viễn toàn bộ tiến độ (Đã thuộc / Chưa thuộc / SRS) của type+level này ====
// Khác với "Học lại từ đầu" (chỉ reset lượt xem hiện tại), nút này xoá luôn cả
// learnedStorageKey / storageKey (unlearned) / srsStorageKey / srsEnabledKey — tức thành tích lâu dài.
function clearAllProgress() {
    const confirmed = window.confirm(
        `Thao tác này sẽ XOÁ VĨNH VIỄN:\n` +
        `- Toàn bộ danh sách "Đã thuộc" và "Chưa thuộc"\n` +
        `- Toàn bộ lịch ôn tập SRS\n` +
        `của mục ${typeKey.toUpperCase()} - ${levelKey.toUpperCase()}.\n\n` +
        `Bạn có chắc chắn muốn tiếp tục không?`
    );
    if (!confirmed) return;

    localStorage.removeItem(learnedStorageKey);
    localStorage.removeItem(storageKey);
    localStorage.removeItem(srsStorageKey);
    localStorage.removeItem(srsEnabledKey);
    localStorage.removeItem(confettiFlagKey);
    clearSession();

    srsData = {};
    restart(false);
}
document.getElementById('btn-clear-all').addEventListener('click', clearAllProgress);

// ==== Phím tắt bàn phím ====
document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement && document.activeElement.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (document.getElementById('card-nav-wrapper').style.display === 'none') return;

    if (e.code === 'Space' || e.key === 'Enter') {
        e.preventDefault();
        flipCard();
    } else if (e.key === 'ArrowLeft') {
        prevCard();
    } else if (e.key === 'ArrowRight') {
        nextCard();
    } else if (isSrsEnabled()) {
        if (e.key === '1') gradeCard(0);
        else if (e.key === '2') gradeCard(1);
        else if (e.key === '3') gradeCard(2);
        else if (e.key === '4') gradeCard(3);
    } else {
        if (e.key === '1') markCard(false);
        else if (e.key === '2') markCard(true);
    }
});

// ==== Vuốt trên mobile (swipe kiểu Tinder) ====
const scene = document.getElementById('card-scene');
const cardInner = document.getElementById('card-inner');
let touchStartX = 0, touchStartY = 0, touchDX = 0, isDragging = false, justSwiped = false;
const SWIPE_THRESHOLD = 80;

scene.addEventListener('touchstart', (e) => {
    if (!e.touches || e.touches.length !== 1) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchDX = 0;
    isDragging = true;
    cardInner.style.transition = 'none';
}, { passive: true });

scene.addEventListener('touchmove', (e) => {
    if (!isDragging || !e.touches || e.touches.length !== 1) return;
    const dx = e.touches[0].clientX - touchStartX;
    const dy = e.touches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
        touchDX = dx;
        const rot = Math.max(-15, Math.min(15, dx / 10));
        cardInner.style.transform = `translateX(${dx}px) rotate(${rot}deg)`;
        document.getElementById('swipe-hint-left').style.opacity = dx < -20 ? Math.min(1, -dx / SWIPE_THRESHOLD) : 0;
        document.getElementById('swipe-hint-right').style.opacity = dx > 20 ? Math.min(1, dx / SWIPE_THRESHOLD) : 0;
    }
}, { passive: true });

scene.addEventListener('touchend', () => {
    if (!isDragging) return;
    isDragging = false;
    cardInner.style.transition = '';
    document.getElementById('swipe-hint-left').style.opacity = 0;
    document.getElementById('swipe-hint-right').style.opacity = 0;

    if (Math.abs(touchDX) >= SWIPE_THRESHOLD) {
        justSwiped = true;
        const known = touchDX > 0;
        cardInner.style.transform = `translateX(${known ? 600 : -600}px) rotate(${known ? 20 : -20}deg)`;
        setTimeout(() => {
            cardInner.style.transform = '';
            if (isSrsEnabled()) gradeCard(known ? 2 : 0);
            else markCard(known);
        }, 150);
    } else {
        cardInner.style.transform = '';
    }
    touchDX = 0;
});

// Khởi chạy lần đầu
updateSrsToggleUI();
updateCounters();
updateUndoButton();
renderCard();
    </script>
</body>
</html>
